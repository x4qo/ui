                        if not typing and items[ "search_box" ].Text == "" then
                            set_search(false)
                        end
                    end)

                    items[ "search_icon" ].MouseButton1Click:Connect(function()
                        set_search(true)
                        items[ "search_box" ]:CaptureFocus()
                    end)

                    items[ "search_box" ].Focused:Connect(function()
                        typing = true
                    end)
                    items[ "search_box" ].FocusLost:Connect(function()
                        typing = false
                        if items[ "search_box" ].Text == "" then
                            set_search(false)
                        end
                    end)
                end
                end

                -- Drop shadow removed: the large slice-image behind the window
                -- re-composited/re-sliced every frame it moved or resized, which was
