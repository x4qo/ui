                    Padding = dim(0, 1)
                });

                items[ "brand" ] = library:create( "TextLabel" , {
                    FontFace = fonts.font;
                    Parent = items[ "title_text" ];
                    Name = "\0";
                    LayoutOrder = 1;
                    Text = string.format("%s %s", cfg.name, cfg.suffix);
                    BackgroundTransparency = 1;
                    BorderSizePixel = 0;
                    BorderColor3 = rgb(0, 0, 0);
                    Size = dim2(1, 0, 0, 21);
                    TextColor3 = rgb(255, 255, 255);
                    TextXAlignment = Enum.TextXAlignment.Left;
                    TextScaled = true;
                    TextSize = 19;
                    BackgroundColor3 = rgb(255, 255, 255)
                });

                library:create( "UITextSizeConstraint" , {
                    Parent = items[ "brand" ];
                    MaxTextSize = 19;
                    MinTextSize = 10
                });

                library.brand_gradient = library:create( "UIGradient" , {
                    Parent = items[ "brand" ];
                    Rotation = 0;
                    Color = accent_sequence(themes.preset.accent)
                });

                local title_gradients = {}
                local title_driver_started = false
                local title_shine_seq = nil
                local title_white = rgb(255, 255, 255)

                local function title_build_shine(c)
                    local hi  = c:Lerp(title_white, 0.85)
                    local mid = c:Lerp(title_white, 0.45)
                    return rgbseq({
                        rgbkey(0.00, c),
                        rgbkey(0.28, c),
                        rgbkey(0.40, mid),
                        rgbkey(0.50, hi),
                        rgbkey(0.60, mid),
                        rgbkey(0.72, c),
                        rgbkey(1.00, c),
                    })
                end

                -- Title shine animation removed: titles render as a static gradient,
                -- so there is no driver to start. Kept as a no-op because the build
                -- path calls it for every registered title.
                local function start_title_driver()
                end

                local function stop_title_driver()
                    -- Settle every gradient to a static (non-shifting) look so titles
                    -- still render nicely with zero per-frame work.
                    if title_shine_seq then
                        for idx = 1, #title_gradients do
                            local g = title_gradients[idx]
                            if g.Parent then
                                g.Color = title_shine_seq
                                g.Offset = vec2(0, 0)
                            end
                        end
                    end
                end

                local function animate_title(grad)
                    insert(title_gradients, grad)
                    if title_shine_seq then grad.Color = title_shine_seq end
                    if library.animations_enabled then
                        start_title_driver()
                    end
                end

                library.animate_title = animate_title
                library:register_anim_driver({ start = start_title_driver, stop = stop_title_driver })

                if library.animated_title then
                    animate_title(library.brand_gradient)
                end

                items[ "subtitle" ] = library:create( "TextLabel" , {
                    FontFace = fonts.small;
