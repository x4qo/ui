    local set_thread_identity = setthreadidentity
        or setidentity
        or set_thread_identity
        or (syn and syn.set_thread_identity)
    local function restore_capability()
        if set_thread_identity then
            pcall(set_thread_identity, 8)
        end
    end

    local function random_gui_name()
        local ok, guid = pcall(function()
            return http_service:GenerateGUID(false)
        end)
        if ok and type(guid) == "string" then
            guid = guid:gsub("[^%w]", "")
            if #guid > 0 then
                return guid
            end
        end
        local chars = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789"
        local out = {}
        for i = 1, 24 do
            local idx = math.random(1, #chars)
            out[i] = chars:sub(idx, idx)
        end
        return table.concat(out)
    end

