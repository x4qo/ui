    local fonts = {}; do
        function Register_Font(Name, Weight, Style, Asset)
            if not isfile(Asset.Id) then
                local requestFunc = type(request) == "function" and request or nil
                if not requestFunc then
                    return "rbxasset://fonts/families/GothamSSm.json"
                end
                local ok, font_data = pcall(function()
                    local response = requestFunc({
                        Url = Asset.Url,
                        Method = "GET",
                        Headers = { ["User-Agent"] = "MyHub" },
                    })
                    local statusCode = type(response) == "table" and tonumber(response.StatusCode or response.status_code or response.Status) or 200
                    if statusCode and (statusCode < 200 or statusCode >= 300) then
                        return nil
                    end
                    return type(response) == "table" and response.Body or response
                end)
                if not ok or type(font_data) ~= "string" or font_data == "" then
                    return "rbxasset://fonts/families/GothamSSm.json"
                end
                writefile(Asset.Id, font_data)
            end

            local font_file = Name .. ".font"
            if not isfile(font_file) then
                local Data = {
                    name = Name,
                    faces = {
                        {
                            name = "Normal",
                            weight = Weight,
                            style = Style,
                            assetId = getcustomasset(Asset.Id),
                        },
                    },
                }

                writefile(font_file, http_service:JSONEncode(Data))
            end

            return getcustomasset(font_file);
        end

        local inter_resolved = false
        function resolve_inter_fonts()
            if inter_resolved then return fonts.inter_main, fonts.inter_small end
            inter_resolved = true

            local Medium = Register_Font("Medium", 200, "Normal", {
                Id = "Medium.ttf",
                Url = "https://github.com/i77lhm/storage/raw/refs/heads/main/fonts/Inter_28pt-Medium.ttf",
            })

            local SemiBold = Register_Font("SemiBold", 200, "Normal", {
                Id = "SemiBold.ttf",
                Url = "https://github.com/i77lhm/storage/raw/refs/heads/main/fonts/Inter_28pt-SemiBold.ttf",
            })

            fonts.inter_small = Font.new(Medium, Enum.FontWeight.Regular, Enum.FontStyle.Normal)
            fonts.inter_main  = Font.new(SemiBold, Enum.FontWeight.Regular, Enum.FontStyle.Normal)
            return fonts.inter_main, fonts.inter_small
        end

        fonts = {
            small = Font.new("rbxasset://fonts/families/GothamSSm.json", Enum.FontWeight.Medium);
            font  = Font.new("rbxasset://fonts/families/GothamSSm.json", Enum.FontWeight.SemiBold);
        }
    end

    -- Weak values: every text instance ever created is registered here so set_font
    -- can restyle them, but runtime churn (notifications, dropdown option rows,
    -- keybind rows, tooltips) creates and destroys thousands of these. A strong
    -- table would pin every destroyed instance in memory forever and make set_font
    -- walk an ever-growing list -- a steady FPS/memory decay over a long session.
    local font_users = {
        main = setmetatable({}, { __mode = "v" }),
        small = setmetatable({}, { __mode = "v" }),
        next_id = 0,
    }
    local font_presets = {
        { name = "Gotham",       main = Font.new("rbxasset://fonts/families/GothamSSm.json",  Enum.FontWeight.SemiBold), small = Font.new("rbxasset://fonts/families/GothamSSm.json",  Enum.FontWeight.Medium) };
        { name = "Inter",        lazy = resolve_inter_fonts };
        { name = "Builder Sans", main = Font.new("rbxasset://fonts/families/BuilderSans.json", Enum.FontWeight.SemiBold), small = Font.new("rbxasset://fonts/families/BuilderSans.json", Enum.FontWeight.Medium) };
        { name = "Roboto",       main = Font.new("rbxasset://fonts/families/Roboto.json",     Enum.FontWeight.SemiBold), small = Font.new("rbxasset://fonts/families/Roboto.json",     Enum.FontWeight.Medium) };
        { name = "Inconsolata",  main = Font.new("rbxasset://fonts/families/Inconsolata.json", Enum.FontWeight.SemiBold), small = Font.new("rbxasset://fonts/families/Inconsolata.json", Enum.FontWeight.Medium) };
    }

        local tween_info_cache = {}
        local function get_tween_info(time, easing_style)
            local t = time or 0.25
            local style = easing_style or Enum.EasingStyle.Quint
            local by_style = tween_info_cache[t]
            if not by_style then
                by_style = {}
                tween_info_cache[t] = by_style
            end
            local info = by_style[style]
            if not info then
                -- EasingDirection.Out gives the snappy-start / soft-settle feel used
                -- throughout velhubui, which reads as noticeably smoother for UI than
                -- the old symmetric InOut. Applied globally so every tween benefits.
                info = TweenInfo.new(t, style, Enum.EasingDirection.Out, 0, false, 0)
                by_style[style] = info
            end
            return info
        end

        -- Per-instance registry of in-flight tweens, keyed by property name. Weak keys
        -- so destroyed instances drop out on their own.
        local active_tweens = setmetatable({}, { __mode = "k" })

        -- Cancel any tween already animating a property before starting a new one on
        -- it. Roblox does NOT do this: firing a second tween at the same property
        -- leaves both running and fighting, so rapid interaction (spamming a toggle,
        -- a keybind, the menu bind, stacking notifications) piled up overlapping
        -- tweens that got progressively jankier and cost real frame time. One tween
        -- per property at a time, always.
        function library:tween(obj, properties, easing_style, time)
            if not obj then return end

            local ok, tween = pcall(function()
                return tween_service:Create(obj, get_tween_info(time, easing_style), properties)
            end)
            if not ok or not tween then return end

            local bag = active_tweens[obj]
            if not bag then
                bag = {}
                active_tweens[obj] = bag
            end

            for property in pairs(properties) do
                local previous = bag[property]
                if previous and previous ~= tween then
                    pcall(function() previous:Cancel() end)
                end
                bag[property] = tween
            end

            tween:Play()
            return tween
        end

        -- No per-frame FPS/ping driver. Consumers are still registered so callers do
        -- not have to change, but nothing drives them and nothing is connected.
        function library:on_fps(callback)
            if not self.fps_consumers then self.fps_consumers = {} end
            insert(self.fps_consumers, callback)
        end

        function library:resizify(frame, shadow, on_begin, on_end, use_ghost)
            local Frame = Instance.new("TextButton")
            Frame.Position = dim2(1, -10, 1, -10)
            Frame.BorderColor3 = rgb(0, 0, 0)
            Frame.Size = dim2(0, 10, 0, 10)
            Frame.BorderSizePixel = 0
            Frame.BackgroundColor3 = rgb(255, 255, 255)
            Frame.Parent = frame
            Frame.BackgroundTransparency = 1
            Frame.Text = ""

            local start_size
            local start
            local og_size = frame.Size
            local resize_conn
            local render_conn
            local target_size
            local dirty = false
            local ghost

            -- InputChanged fires several times per rendered frame; record the most
            -- recent target and flush a single Size write per frame so we only
            -- re-slice the window (and its shadow) once a frame instead of many.
            local function on_resize(input)
                if input.UserInputType == Enum.UserInputType.MouseMovement then
                    local viewport_x = camera.ViewportSize.X
                    local viewport_y = camera.ViewportSize.Y

                    target_size = dim2(
                        start_size.X.Scale,
                        math.clamp(
                            start_size.X.Offset + (input.Position.X - start.X),
                            og_size.X.Offset,
                            viewport_x
                        ),
                        start_size.Y.Scale,
                        math.clamp(
                            start_size.Y.Offset + (input.Position.Y - start.Y),
                            og_size.Y.Offset,
                            viewport_y
                        )
                    )
                    dirty = true
                end
            end

            local function apply()
                if dirty and target_size then
                    if ghost and ghost.Visible then
                        ghost.Size = target_size
                    else
                        frame.Size = target_size
                    end
                    dirty = false
                end
            end

            local active = false

            local function stop()
                if resize_conn then resize_conn:Disconnect(); resize_conn = nil end
                if render_conn then render_conn:Disconnect(); render_conn = nil end
                dirty = false
                if ghost and ghost.Visible then
                    frame.Size = ghost.Size
                    ghost.Visible = false
                    frame.Visible = true
                end
                if shadow then shadow.Visible = true end
                if active then
                    active = false
                    if on_end then on_end() end
                end
            end

            Frame.InputBegan:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1 then
                    start = input.Position
                    start_size = frame.Size
                    stop()
                    active = true
                    if on_begin then on_begin() end
                    if use_ghost then
                        if not ghost then ghost = library:ghost_for(frame) end
                        ghost.Size = frame.Size
                        ghost.Position = frame.Position
                        ghost.Visible = true
                        frame.Visible = false
                    end
                    -- The slice-image shadow re-slices every frame the window size
                    -- changes; hide it while resizing to keep FPS up.
                    if shadow then shadow.Visible = false end
                    resize_conn = uis.InputChanged:Connect(on_resize)
                    render_conn = run.RenderStepped:Connect(apply)
                end
            end)

            library:connection(uis.InputEnded, function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1 then
                    stop()
                end
            end)
        end

        function fag(tbl)
            local Size = 0

            for _ in tbl do
                Size = Size + 1
            end

            return Size
        end

        function library:next_flag()
            local index = fag(library.flags) + 1;
            local str = string.format("flagnumber%s", index)

            return str;
        end

        function library:mouse_in_frame(uiobject)
            local y_cond = uiobject.AbsolutePosition.Y <= mouse.Y and mouse.Y <= uiobject.AbsolutePosition.Y + uiobject.AbsoluteSize.Y
            local x_cond = uiobject.AbsolutePosition.X <= mouse.X and mouse.X <= uiobject.AbsolutePosition.X + uiobject.AbsoluteSize.X

            return (y_cond and x_cond)
        end

        -- A cheap stand-in used while dragging/resizing a heavy frame. Moving a
        -- frame re-propagates the transform to every descendant every frame; the
        -- window has hundreds, so that is what costs the frame time no matter how
        -- few property writes we do. The ghost is 3 instances with nothing inside
        -- it, so moving it is free regardless of how big the real window is.
        function library:ghost_for(frame)
            local ghost = library:create( "Frame" , {
                Parent = frame.Parent;
                Name = "\0";
                BackgroundColor3 = rgb(20, 20, 24);
                BackgroundTransparency = 0.25;
                BorderSizePixel = 0;
                Visible = false;
                ZIndex = 500;
            })
            library:create( "UICorner" , { Parent = ghost; CornerRadius = dim(0, 8) })
            library:create( "UIStroke" , {
                Parent = ghost;
                Color = themes.preset.accent;
                Thickness = 1;
                Transparency = 0.2;
            })
            return ghost
        end

        function library:draggify(frame, shadow, on_begin, on_end, use_ghost)
            local start_size = frame.Position
            local start
            local move_conn
            local render_conn
            local target_position
            local dirty = false
            local ghost

            -- InputChanged can fire several times per rendered frame; only the
            -- most recent target matters, so we just record it here and flush a
            -- single Position write per frame in RenderStepped. This avoids
            -- invalidating the whole window's layout multiple times a frame,
            -- which is what tanks FPS while dragging.
            local function on_move(input)
                if input.UserInputType == Enum.UserInputType.MouseMovement then
                    local viewport_x = camera.ViewportSize.X
                    local viewport_y = camera.ViewportSize.Y

                    target_position = dim2(
                        0,
                        clamp(
                            start_size.X.Offset + (input.Position.X - start.X),
                            0,
                            viewport_x - frame.Size.X.Offset
                        ),
                        0,
                        math.clamp(
                            start_size.Y.Offset + (input.Position.Y - start.Y),
                            0,
                            viewport_y - frame.Size.Y.Offset
                        )
                    )
                    dirty = true
                end
            end

            local function apply()
                if dirty and target_position then
                    -- Drive the ghost while dragging; the real window is hidden and
                    -- untouched, so nothing re-lays out until the drag ends.
                    if ghost and ghost.Visible then
                        ghost.Position = target_position
                    else
                        frame.Position = target_position
                    end
                    dirty = false
                end
            end

            local active = false

            local function stop()
                if move_conn then move_conn:Disconnect(); move_conn = nil end
                if render_conn then render_conn:Disconnect(); render_conn = nil end
                dirty = false
                if ghost and ghost.Visible then
                    -- Land the real window where the ghost ended up. This is the
                    -- only layout pass the whole drag costs.
                    frame.Position = ghost.Position
                    ghost.Visible = false
                    frame.Visible = true
                end
                -- Restore the drop shadow once the drag ends.
                if shadow then shadow.Visible = true end
                if active then
                    active = false
                    if on_end then on_end() end
                end
            end

            frame.InputBegan:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1 then
                    start = input.Position
                    start_size = frame.Position
                    library:close_element()
                    stop()
                    active = true
                    if on_begin then on_begin() end
                    if use_ghost then
                        if not ghost then ghost = library:ghost_for(frame) end
                        ghost.Size = frame.Size
                        ghost.Position = frame.Position
                        ghost.Visible = true
                        frame.Visible = false
                    end
                    -- A large soft slice-image shadow re-composites over the whole
                    -- screen every frame the window moves, which is what tanks FPS
                    -- while dragging. Hide it for the duration of the drag.
                    if shadow then shadow.Visible = false end
                    move_conn = uis.InputChanged:Connect(on_move)
                    render_conn = run.RenderStepped:Connect(apply)
                end
            end)

            library:connection(uis.InputEnded, function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1 then
                    stop()
                end
            end)
        end

        function library:convert(str)
            local values = {}

            for value in string.gmatch(str, "[^,]+") do
                insert(values, tonumber(value))
            end

            if #values == 4 then
                return unpack(values)
            else
                return
            end
        end

        function library:convert_enum(enum)
            local enum_parts = {}

            for part in string.gmatch(enum, "[%w_]+") do
                insert(enum_parts, part)
            end

            local enum_table = Enum
            for i = 2, #enum_parts do
                local enum_item = enum_table[enum_parts[i]]

                enum_table = enum_item
            end

            return enum_table
        end

        local config_holder;
        function library:update_config_list()
            if not config_holder then
                return
            end

            local list = {}

            for idx, file in listfiles(library.directory .. "/configs") do
                local name = file:gsub(library.directory .. "/configs\\", ""):gsub(".cfg", ""):gsub(library.directory .. "\\configs\\", "")
                list[#list + 1] = name
            end

            config_holder.refresh_options(list)
        end

        function library:get_config()
            local Config = {}

            for _, v in next, flags do
                if type(v) == "table" and v.key then
                    Config[_] = {active = v.active, mode = v.mode, key = tostring(v.key)}
                elseif type(v) == "table" and v["Transparency"] and v["Color"] then
                    Config[_] = {Transparency = v["Transparency"], Color = v["Color"]:ToHex()}
                else
                    Config[_] = v
                end
            end

            return http_service:JSONEncode(Config)
        end

        function library:load_config(config_json)
            local config = http_service:JSONDecode(config_json)

            for _, v in config do
                local function_set = library.config_flags[_]

                if _ == "config_name_list" then
                    continue
                end

                if function_set then
                    if type(v) == "table" and v["Transparency"] and v["Color"] then
                        function_set(hex(v["Color"]), v["Transparency"])
                    elseif type(v) == "table" and v["active"] then
                        function_set(v)
                    else
                        function_set(v)
                    end
                end
            end
        end

        function library:round(number, float)
            local multiplier = 1 / (float or 1)

            return floor(number * multiplier + 0.5) / multiplier
        end

        function library:apply_theme(instance, theme, property)
            -- Monotonic key: the registry is weak-valued, so `#t + 1` would land on
            -- an index that is still live and silently drop that instance's theming.
            themes.next_id = themes.next_id + 1
            themes.utility[theme][property][themes.next_id] = instance
        end

        function library:update_theme(theme, color)
            if themes.preset[theme] == color then
                return
            end

            for _, property in themes.utility[theme] do

                for m, object in property do
                    if object[_] == themes.preset[theme] then
                        object[_] = color
                    end
                end
            end

            themes.preset[theme] = color

            if theme == "accent" and library.brand_gradient then
                library.brand_gradient.Color = accent_sequence(color)
            end

            if theme == "accent" and library.game_gradient then
                library.game_gradient.Color = accent_sequence(color)
            end

            if theme == "accent" and library.keybind_title_gradient then
                library.keybind_title_gradient.Color = accent_sequence(color)
            end

            if theme == "accent" and library.presence_title_gradient then
                library.presence_title_gradient.Color = accent_sequence(color)
            end
        end

        function library:connection(signal, callback)
            local connection = signal:Connect(callback)

            insert(library.connections, connection)

            return connection
        end

        function library:close_element(new_path)
            local open_element = library.current_open

            if open_element and new_path ~= open_element then
                open_element.set_visible(false)
                open_element.open = false;
            end

            if new_path ~= open_element then
                library.current_open = new_path or nil;
            end
        end

        local BUILD_BUDGET = 0.004
        local build_armed = false
        local build_slice_start = 0

        function library:begin_build()
            build_armed = true
            build_slice_start = os.clock()
        end

        function library:end_build()
            build_armed = false
        end

        function library:create(instance, options)
            if build_armed then
                local now = os.clock()
                if now - build_slice_start >= BUILD_BUDGET then
                    task.wait()
                    build_slice_start = os.clock()
                end
            end
            local ins = Instance.new(instance)

            -- Set every property BEFORE parenting. Writing properties on an
            -- already-parented instance forces the engine to re-run layout,
            -- redraw and replicate on each individual assignment; doing all the
            -- writes while the instance is still orphaned collapses that into a
            -- single insertion cost. This is the single biggest smoothness win
            -- when the UI is being built, since every widget funnels through here.
            local parent = options.Parent
            for prop, value in options do
                if prop ~= "Parent" then
                    ins[prop] = value
                end
            end
            if parent ~= nil then
                ins.Parent = parent
            end

            -- Monotonic key, not table.insert: font_users is weak-valued, so entries
            -- disappear as instances are collected and `#t + 1` would resolve to an
            -- index that is still live and overwrite it.
            if options.FontFace == fonts.font then
                font_users.next_id = font_users.next_id + 1
                font_users.main[font_users.next_id] = ins
            elseif options.FontFace == fonts.small then
                font_users.next_id = font_users.next_id + 1
                font_users.small[font_users.next_id] = ins
            end

            return ins
        end

        function library:get_fonts()
            local names = {}
            for _, preset in font_presets do
                insert(names, preset.name)
            end
            return names
        end

        library.active_font_preset = "Gotham"

        function library:set_font(name)
            if library.active_font_preset == name then return end

            local preset
            for _, p in font_presets do
                if p.name == name then preset = p break end
            end
            if not preset then return end

            if preset.lazy and not preset.main then
                local ok, main, small = pcall(preset.lazy)
                if not ok or not main then return end
                preset.main, preset.small = main, small
            end
            if not preset.main then return end

            library.active_font_preset = name
            fonts.font, fonts.small = preset.main, preset.small

            for _, obj in font_users.main do
                pcall(function() obj.FontFace = preset.main end)
            end
            for _, obj in font_users.small do
                pcall(function() obj.FontFace = preset.small end)
            end
        end

        function library:unload_menu()
            if library[ "items" ] then
                library[ "items" ]:Destroy()
            end

            if library[ "other" ] then
                library[ "other" ]:Destroy()
            end

            for index, connection in library.connections do
                connection:Disconnect()
                connection = nil
            end

            library = nil
        end

        function library:version_selector(properties)
            properties = properties or {}

            local sel_name    = properties.name    or properties.Name    or "Vampire"
            local sel_suffix  = properties.suffix  or properties.Suffix  or "Legends"
            local sel_sub     = properties.subtitle or properties.Subtitle or "choose which version to load"
            local sel_icon    = properties.icon    or properties.Icon    or library.window_icon or "rbxassetid://10709790948"

            local options = properties.options or {
                {
                    key   = "safe",
                    tag   = "LITE",
                    title = "Essential",
                    desc  = "Only the essentials — ESP, siphon & aim assist.",
                },
                {
                    key    = "full",
                    tag    = "FULL",
                    title  = "Full",
                    desc   = "The entire script with every feature loaded.",
                    accent = true,
                },
            }

            local white   = rgb(255, 255, 255)
            local accent  = properties.accent or properties.Accent or themes.preset.accent

            local function fastTween(obj, props, time, style)
                return tween_service:Create(
                    obj,
                    TweenInfo.new(time or 0.12, style or Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
                    props
                ):Play()
            end

            local FONT_BOLD = Enum.Font.GothamBold
            local FONT_MED  = Enum.Font.GothamMedium
            local FONT_REG  = Enum.Font.Gotham

            restore_capability()
            local sel_gui = library:create("ScreenGui", {
                Parent = gethui();
                Name = random_gui_name();
                Enabled = true;
                ResetOnSpawn = false;
                DisplayOrder = 2000000;
                ZIndexBehavior = Enum.ZIndexBehavior.Sibling;
                IgnoreGuiInset = true;
            })

            local backdrop = library:create("Frame", {
                Parent = sel_gui;
                Name = "\0";
                Size = dim2(1, 0, 1, 0);
                BorderSizePixel = 0;
                BackgroundColor3 = rgb(0, 0, 0);
                BackgroundTransparency = 1;
            })
            library:tween(backdrop, { BackgroundTransparency = 0.5 }, Enum.EasingStyle.Quint, 0.3)

            local blur = Instance.new("BlurEffect")
            blur.Name = "\0"
            blur.Size = 0
            blur.Parent = lighting
            library:tween(blur, { Size = 20 }, Enum.EasingStyle.Quint, 0.35)

            local PANEL_W, PANEL_H = 460, 268
            local panel = library:create("Frame", {
                Parent = sel_gui;
                Name = "\0";
                AnchorPoint = vec2(0.5, 0.5);
                Position = dim2(0.5, 0, 0.5, 0);
                Size = dim2(0, PANEL_W, 0, PANEL_H);
                BorderSizePixel = 0;
                BackgroundColor3 = rgb(15, 15, 18);
                BackgroundTransparency = 1;
            })
            local panel_stroke = library:create("UIStroke", {
                Parent = panel;
                Color = rgb(33, 33, 41);
                Transparency = 1;
                ApplyStrokeMode = Enum.ApplyStrokeMode.Border;
            })
            library:create("UICorner", { Parent = panel; CornerRadius = dim(0, 14) })

            local panel_scale = library:create("UIScale", { Parent = panel; Scale = 0.9 })
            library:tween(panel_scale, { Scale = 1 }, Enum.EasingStyle.Quint, 0.32)
            library:tween(panel, { BackgroundTransparency = 0 }, Enum.EasingStyle.Quint, 0.28)
            library:tween(panel_stroke, { Transparency = 0.05 }, Enum.EasingStyle.Quint, 0.28)

            local badge = library:create("Frame", {
                Parent = panel;
                Name = "\0";
                Position = dim2(0, 20, 0, 20);
                Size = dim2(0, 40, 0, 40);
                BorderSizePixel = 0;
                BackgroundTransparency = 1;
                BackgroundColor3 = accent;
            })
            library:create("ImageLabel", {
                Parent = badge;
                Name = "\0";
                AnchorPoint = vec2(0.5, 0.5);
                Position = dim2(0.5, 0, 0.5, 0);
                Size = dim2(0, 40, 0, 40);
                BackgroundTransparency = 1;
                Image = sel_icon;
                ImageColor3 = white;
            })

            local brand = library:create("TextLabel", {
                Font = FONT_BOLD;
                Parent = panel;
                Name = "\0";
                Position = dim2(0, 70, 0, 22);
                Size = dim2(1, -90, 0, 20);
                BackgroundTransparency = 1;
                Text = string.format("%s %s", sel_name, sel_suffix);
                TextColor3 = white;
                TextXAlignment = Enum.TextXAlignment.Left;
                TextSize = 18;
            })

            local brand_grad = library:create("UIGradient", {
                Parent = brand;
                Rotation = 0;
                Color = rgbseq{
                    rgbkey(0.00, accent),
                    rgbkey(1.00, accent),
                };
            })

            library:create("TextLabel", {
                Font = FONT_REG;
                Parent = panel;
                Name = "\0";
                Position = dim2(0, 70, 0, 43);
                Size = dim2(1, -90, 0, 15);
                BackgroundTransparency = 1;
                Text = sel_sub;
                TextColor3 = rgb(130, 130, 140);
                TextXAlignment = Enum.TextXAlignment.Left;
                TextSize = 13;
            })

            library:create("Frame", {
                Parent = panel;
                Name = "\0";
                Position = dim2(0, 18, 0, 76);
                Size = dim2(1, -36, 0, 1);
                BorderSizePixel = 0;
                BackgroundColor3 = rgb(30, 30, 37);
            })

            local alive = true
            local shine_conn
            local shine_t = 0
            local function start_shine()
                if shine_conn or not alive then return end
                shine_conn = run.RenderStepped:Connect(function(dt)
                    if not alive then return end
                    shine_t = (shine_t + dt * 0.35) % 1
                    if brand_grad and brand_grad.Parent then
                        brand_grad.Offset = vec2(shine_t * 2 - 1, 0)
                    end
                end)
            end
            local function stop_shine()
                if shine_conn then shine_conn:Disconnect(); shine_conn = nil end
                if brand_grad and brand_grad.Parent then brand_grad.Offset = vec2(0, 0) end
            end
            library:register_anim_driver({ start = start_shine, stop = stop_shine })

            local body = library:create("Frame", {
                Parent = panel;
                Name = "\0";
                Position = dim2(0, 18, 0, 92);
                Size = dim2(1, -36, 1, -110);
                BackgroundTransparency = 1;
            })
            library:create("UIListLayout", {
                Parent = body;
                FillDirection = Enum.FillDirection.Horizontal;
                HorizontalAlignment = Enum.HorizontalAlignment.Center;
                SortOrder = Enum.SortOrder.LayoutOrder;
                Padding = dim(0, 12);
            })

            local chosen = nil
            local cardRefs = {}

            local function make_option(order, opt)
                local base_bg = opt.accent and accent:Lerp(rgb(17, 17, 20), 0.86) or rgb(21, 21, 25)
                local hover_bg = opt.accent and accent:Lerp(rgb(17, 17, 20), 0.78) or rgb(27, 27, 32)
                local base_stroke = opt.accent and accent or rgb(34, 34, 42)
                local base_stroke_t = opt.accent and 0.45 or 0

                local card = library:create("TextButton", {
                    Parent = body;
                    Name = "\0";
                    LayoutOrder = order;
                    AutoButtonColor = false;
                    Text = "";
                    Size = dim2(0.5, -6, 1, 0);
                    BorderSizePixel = 0;
                    BackgroundColor3 = base_bg;
                })
                library:create("UICorner", { Parent = card; CornerRadius = dim(0, 10) })
                local cstroke = library:create("UIStroke", {
                    Parent = card;
                    Color = base_stroke;
                    Transparency = base_stroke_t;
                    Thickness = 1;
                })
                local cscale = library:create("UIScale", { Parent = card; Scale = 1 })
                insert(cardRefs, { card = card, scale = cscale })

                local pill = library:create("Frame", {
                    Parent = card;
                    Name = "\0";
                    Position = dim2(0, 14, 0, 14);
                    Size = dim2(0, 46, 0, 20);
                    BorderSizePixel = 0;
                    BackgroundColor3 = opt.accent and accent or rgb(30, 30, 37);
                })
                library:create("UICorner", { Parent = pill; CornerRadius = dim(0, 6) })
                library:create("TextLabel", {
                    Font = FONT_BOLD;
                    Parent = pill;
                    Name = "\0";
                    Size = dim2(1, 0, 1, 0);
                    BackgroundTransparency = 1;
                    Text = opt.tag or "";
                    TextColor3 = opt.accent and rgb(16, 16, 19) or rgb(190, 190, 200);
                    TextSize = 11;
                })

                library:create("TextLabel", {
                    Font = FONT_BOLD;
                    Parent = card;
                    Name = "\0";
                    Position = dim2(0, 14, 0, 44);
                    Size = dim2(1, -28, 0, 22);
                    BackgroundTransparency = 1;
                    Text = opt.title or tostring(opt.key);
                    TextColor3 = white;
                    TextXAlignment = Enum.TextXAlignment.Left;
                    TextSize = 18;
                })
                library:create("TextLabel", {
                    Font = FONT_REG;
                    Parent = card;
                    Name = "\0";
                    Position = dim2(0, 14, 0, 70);
                    Size = dim2(1, -28, 1, -84);
                    BackgroundTransparency = 1;
                    Text = opt.desc or "";
                    TextWrapped = true;
                    TextColor3 = rgb(140, 140, 150);
                    TextXAlignment = Enum.TextXAlignment.Left;
                    TextYAlignment = Enum.TextYAlignment.Top;
                    TextSize = 12.5;
                })

                local underline = library:create("Frame", {
                    Parent = card;
                    Name = "\0";
                    AnchorPoint = vec2(0.5, 1);
                    Position = dim2(0.5, 0, 1, -12);
                    Size = dim2(0, opt.accent and 40 or 0, 0, 2);
                    BorderSizePixel = 0;
                    BackgroundColor3 = accent;
                })
                library:create("UICorner", { Parent = underline; CornerRadius = dim(0, 2) })

                card.MouseEnter:Connect(function()
                    if chosen then return end
                    fastTween(card, { BackgroundColor3 = hover_bg }, 0.12)
                    fastTween(cstroke, { Color = accent, Transparency = 0.1 }, 0.12)
                    fastTween(cscale, { Scale = 1.03 }, 0.12)
                    fastTween(underline, { Size = dim2(1, -28, 0, 2) }, 0.12)
                end)
                card.MouseLeave:Connect(function()
                    if chosen then return end
                    fastTween(card, { BackgroundColor3 = base_bg }, 0.12)
                    fastTween(cstroke, { Color = base_stroke, Transparency = base_stroke_t }, 0.12)
                    fastTween(cscale, { Scale = 1 }, 0.12)
                    fastTween(underline, { Size = dim2(0, opt.accent and 40 or 0, 0, 2) }, 0.12)
                end)
                card.MouseButton1Click:Connect(function()
                    if chosen then return end
                    chosen = opt.key

                    fastTween(cstroke, { Color = accent, Transparency = 0 }, 0.1)
                    fastTween(underline, { Size = dim2(1, -28, 0, 2) }, 0.12)
                    fastTween(cscale, { Scale = 1.05 }, 0.12, Enum.EasingStyle.Back)
                    task.delay(0.12, function()
                        if cscale and cscale.Parent then
                            fastTween(cscale, { Scale = 1 }, 0.1)
                        end
                    end)

                    for _, ref in ipairs(cardRefs) do
                        if ref.card ~= card then
                            fastTween(ref.scale, { Scale = 0 }, 0.16)
                            fastTween(ref.card, { BackgroundTransparency = 1 }, 0.16)
                        end
                    end
                end)
            end

            for i, opt in ipairs(options) do
                make_option(i, opt)
            end

            repeat run.RenderStepped:Wait() until chosen ~= nil

            alive = false
            if shine_conn then shine_conn:Disconnect() end

            task.wait(0.16)

            local EXIT_TIME = 0.2
            fastTween(panel_scale, { Scale = 0.88 }, EXIT_TIME)
            fastTween(panel, { BackgroundTransparency = 1 }, EXIT_TIME)
            fastTween(panel_stroke, { Transparency = 1 }, EXIT_TIME)
            fastTween(backdrop, { BackgroundTransparency = 1 }, EXIT_TIME)
            fastTween(blur, { Size = 0 }, EXIT_TIME)

            task.wait(EXIT_TIME)

            if sel_gui then sel_gui:Destroy() end
            if blur then blur:Destroy() end

            return chosen
        end

        function library:window(properties)
            local cfg = {
                suffix = properties.suffix or properties.Suffix or "tech";
                name = properties.name or properties.Name or "nebula";
                subtitle = properties.subtitle or properties.Subtitle or properties.author or properties.Author or "subscription";
                icon = properties.icon or properties.Icon or "rbxassetid://10709790948";
                game_name = properties.gameInfo or properties.game_info or properties.GameInfo or "Milenium for Counter-Strike: Global Offensive";
                size = properties.size or properties.Size or dim2(0, 700, 0, 565);
                selected_tab;
                items = {};

                tween;
            }

            library.window_icon = cfg.icon

            library.animated_title = properties.animated_title or properties.AnimatedTitle or false

            local search_enabled = properties.search or properties.Search
                or properties.searchbar or properties.SearchBar or false

            restore_capability()
            library[ "items" ] = library:create( "ScreenGui" , {
                Parent = gui_parent;
                Name = random_gui_name();
                Enabled = true;
                -- Sibling, not Global. Global makes the engine resolve draw order
                -- across EVERY descendant of this ScreenGui as one flat list, so any
                -- ZIndex/visibility change re-sorts the whole ~2000-instance tree --
                -- which is what made dragging and toggling expensive. Everything that
                -- needs to float (window, dock, dropdown holders, colour pickers) is
                -- a direct child of this ScreenGui, so sibling ordering still layers
                -- them correctly by their own ZIndex.
                ZIndexBehavior = Enum.ZIndexBehavior.Sibling;
                IgnoreGuiInset = true;
            });

            library[ "other" ] = library:create( "ScreenGui" , {
                Parent = gui_parent;
                Name = random_gui_name();
                Enabled = false;
                ZIndexBehavior = Enum.ZIndexBehavior.Sibling;
                IgnoreGuiInset = true;
            });

            library[ "notifications_gui" ] = library:create( "ScreenGui" , {
                Parent = gui_parent;
                Name = random_gui_name();
                Enabled = true;
                ResetOnSpawn = false;
                DisplayOrder = 1000000;
                ZIndexBehavior = Enum.ZIndexBehavior.Sibling;
                IgnoreGuiInset = true;
            });

            local items = cfg.items; do
                items[ "main" ] = library:create( "Frame" , {
                    Parent = library[ "items" ];
                    Size = cfg.size;
                    Name = "\0";
                    Position = dim2(0.5, -cfg.size.X.Offset / 2, 0.5, -cfg.size.Y.Offset / 2);
                    BorderColor3 = rgb(0, 0, 0);
                    BorderSizePixel = 0;
                    BackgroundColor3 = rgb(14, 14, 16)
                }); items[ "main" ].Position = dim2(0, items[ "main" ].AbsolutePosition.X, 0, items[ "main" ].AbsolutePosition.Y)

                do
                    local mainScale = library:create( "UIScale" , { Parent = items[ "main" ]; Scale = 0.94 } )
                    items[ "main_scale" ] = mainScale
                    items[ "main" ].BackgroundTransparency = 1
                    library:tween(mainScale, { Scale = 1 }, Enum.EasingStyle.Quint, 0.28)
                    library:tween(items[ "main" ], { BackgroundTransparency = 0 }, Enum.EasingStyle.Quint, 0.22)
                end

                library:create( "UICorner" , {
                    Parent = items[ "main" ];
                    CornerRadius = dim(0, 10)
                });

                library:create( "UIStroke" , {
                    Color = rgb(23, 23, 29);
                    Parent = items[ "main" ];
                    ApplyStrokeMode = Enum.ApplyStrokeMode.Border
                });

                items[ "side_frame" ] = library:create( "Frame" , {
                    Parent = items[ "main" ];
                    BackgroundTransparency = 1;
                    Name = "\0";
                    BorderColor3 = rgb(0, 0, 0);
                    Size = dim2(0, 196, 1, -25);
                    BorderSizePixel = 0;
                    BackgroundColor3 = rgb(14, 14, 16)
                });

                library:create( "Frame" , {
                    AnchorPoint = vec2(1, 0);
                    Parent = items[ "side_frame" ];
                    Position = dim2(1, 0, 0, 0);
                    BorderColor3 = rgb(0, 0, 0);
                    Size = dim2(0, 1, 1, 0);
                    BorderSizePixel = 0;
                    BackgroundColor3 = rgb(21, 21, 23)
                });

                items[ "button_holder" ] = library:create( "Frame" , {
                    Parent = items[ "side_frame" ];
                    Name = "\0";
                    BackgroundTransparency = 1;
                    Position = dim2(0, 0, 0, 60);
                    BorderColor3 = rgb(0, 0, 0);
                    Size = dim2(1, 0, 1, -60);
                    BorderSizePixel = 0;
                    BackgroundColor3 = rgb(255, 255, 255)
                }); cfg.button_holder = items[ "button_holder" ];

