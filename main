    -- Decorative gradient / shine animations have been removed entirely. These two
    -- shims keep the old call sites working but guarantee NO per-frame gradient
    -- animation ever runs: any registered driver is immediately settled to its
    -- static look via stop() and never connected, and toggling "animations" is a
    -- no-op. This eliminates the animated-gradient render loops that dragged FPS
    -- while toggling features.
    function library:register_anim_driver(driver)
        if driver and driver.stop then pcall(driver.stop) end
        return driver
    end

    function library:set_animations_enabled()
        -- intentionally inert: gradient animations no longer exist
    end

    local themes = {
        preset = {
            accent = rgb(255, 255, 255),
        },

        -- Weak values, same reason as font_users: apply_theme registers every themed
        -- instance for later recolouring, including short-lived runtime ones
        -- (dropdown option rows are rebuilt on every refresh, notifications churn
        -- constantly). Strong refs would pin destroyed instances forever and make
        -- update_theme walk a list that only ever grows.
        utility = {
            accent = {
                BackgroundColor3 = setmetatable({}, { __mode = "v" }),
                TextColor3 = setmetatable({}, { __mode = "v" }),
                ImageColor3 = setmetatable({}, { __mode = "v" }),
                ScrollBarImageColor3 = setmetatable({}, { __mode = "v" })
            },
        }
    }
    themes.next_id = 0

    local function accent_sequence(c)
        -- Title gradients removed: return a flat single-colour sequence so every
        -- title / icon "gradient" renders as one solid accent colour with no
        -- visible left-to-right ramp.
        return rgbseq{
            rgbkey(0, c),
            rgbkey(1, c)
        }
    end

    library.search_items = {}
    function library:apply_search(query)
        query = tostring(query or ""):lower():gsub("^%s+", ""):gsub("%s+$", "")

        local sections, has_match = {}, {}
        for _, item in ipairs(self.search_items) do
            if item.frame and item.frame.Parent then
                local match = (query == "") or (item.name:find(query, 1, true) ~= nil)
                item.frame.Visible = match
                local sec = item.section
                if sec then
                    if has_match[sec] == nil then
                        has_match[sec] = false
                        sections[#sections + 1] = sec
                    end
                    if match then has_match[sec] = true end
                end
            end
        end

        for _, sec in ipairs(sections) do
            local box = sec.items and sec.items[ "outline" ]
            if box then
                box.Visible = (query == "") or has_match[sec]
            end
        end
    end

