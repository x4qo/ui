                items[ "other_info" ] = library:create( "TextLabel" , {
                    Parent = items[ "info" ];
                    RichText = true;
                    Name = "\0";
                    TextColor3 = themes.preset.accent;
                    BorderColor3 = rgb(0, 0, 0);
                    Text = '<font color="rgb(72, 72, 73)">fps:</font> 0  <font color="rgb(72, 72, 73)">ping:</font> 0ms';
                    Size = dim2(1, 0, 0, 0);
                    Position = dim2(0, -10, 0.5, -1);
                    AnchorPoint = vec2(0, 0.5);
                    BorderSizePixel = 0;
                    BackgroundTransparency = 1;
                    TextXAlignment = Enum.TextXAlignment.Right;
                    AutomaticSize = Enum.AutomaticSize.XY;
                    FontFace = fonts.font;
                    TextSize = 14;
                    BackgroundColor3 = rgb(255, 255, 255)
                }); library:apply_theme(items[ "other_info" ], "accent", "TextColor3");

                do
                    -- The window info bar's fps/ping is driven externally by the host
                    -- script's single always-on metrics loop via update_info_metrics,
                    -- instead of starting a second per-frame RenderStepped (on_fps)
                    -- here. One loop now feeds both this label and the host's presence
                    -- bar, removing a redundant always-on render loop. The setter keeps
                    -- the same change-detection + menu-hidden early-out the old loop had.
                    local guiRoot   = library[ "items" ]
                    local infoLabel = items[ "other_info" ]
                    local lastFps, lastPing = -1, -1
                    function library:update_info_metrics(fps, ping)
                        if not library.menu_visible then return end
                        if guiRoot and not guiRoot.Enabled then return end
                        fps  = fps or 0
                        ping = ping or 0
                        if fps == lastFps and ping == lastPing then return end
                        lastFps, lastPing = fps, ping
                        infoLabel.Text = string.format(
                            '<font color="rgb(72, 72, 73)">fps:</font> %d  <font color="rgb(72, 72, 73)">ping:</font> %dms',
                            fps, ping
                        )
                    end
                end
            end

            do
                library:draggify(items[ "main" ], items[ "shadow" ], nil, nil, true)
                library:resizify(items[ "main" ], items[ "shadow" ], nil, nil, true)
            end

            -- ── Minimise dock (velhubui-style tab-icon pill) ────────────────────
            -- Closing the menu scales/fades the window away and grows a vertical pill
            -- of the tab icons on the right edge; clicking an icon restores the window
            -- and opens that tab.
            cfg.menu_open = true
            local dock

            -- Dock dragging. The pill is anchored (1, 0.5) with a scale-based
            -- position; normalising to pure offsets once (in that same anchor
            -- space) keeps the grow/shrink animation looking identical while
            -- making drag maths trivial. A movement threshold distinguishes a
            -- drag from a tap, so the icons still work as tab shortcuts.
            local dock_pos_normalised = false
            local dock_suppress_click = false

            local function normalise_dock_position()
                if dock_pos_normalised then return end
                dock_pos_normalised = true
                dock.Position = dim_offset(
                    dock.AbsolutePosition.X + dock.AbsoluteSize.X,
                    dock.AbsolutePosition.Y + dock.AbsoluteSize.Y * 0.5
                )
            end

            local function begin_dock_drag(input)
                if input.UserInputType ~= Enum.UserInputType.MouseButton1
                    and input.UserInputType ~= Enum.UserInputType.Touch then
                    return
                end
                dock_suppress_click = false
                normalise_dock_position()

                local start_pos = dock.Position
                local start_mouse = input.Position
                local moved = false
                local target, dirty = nil, false
                local move_conn, end_conn, render_conn

                local function finish()
                    if move_conn then move_conn:Disconnect(); move_conn = nil end
                    if end_conn then end_conn:Disconnect(); end_conn = nil end
                    if render_conn then render_conn:Disconnect(); render_conn = nil end
                end

                move_conn = uis.InputChanged:Connect(function(i)
                    if i.UserInputType ~= Enum.UserInputType.MouseMovement
                        and i.UserInputType ~= Enum.UserInputType.Touch then
                        return
                    end
                    local dx = i.Position.X - start_mouse.X
                    local dy = i.Position.Y - start_mouse.Y
                    if not moved and (abs(dx) > 4 or abs(dy) > 4) then moved = true end
                    if not moved then return end
                    local sx, sy = dock.AbsoluteSize.X, dock.AbsoluteSize.Y
                    target = dim_offset(
                        clamp(start_pos.X.Offset + dx, sx, camera.ViewportSize.X),
                        clamp(start_pos.Y.Offset + dy, sy * 0.5, camera.ViewportSize.Y - sy * 0.5)
                    )
                    dirty = true
                end)

                render_conn = run.RenderStepped:Connect(function()
                    if dirty and target then
                        dock.Position = target
                        dirty = false
                    end
                end)

                end_conn = uis.InputEnded:Connect(function(i)
                    if i.UserInputType ~= Enum.UserInputType.MouseButton1
                        and i.UserInputType ~= Enum.UserInputType.Touch then
                        return
                    end
                    finish()
                    -- Swallow the click that ends a real drag; cleared by the next
                    -- press rather than on a timer, so there is no ordering race.
                    dock_suppress_click = moved
                end)
            end

            local function build_dock()
                if dock then return dock end
                dock = library:create( "Frame" , {
                    Parent = library[ "items" ];
                    Name = "\0";
                    AnchorPoint = vec2(1, 0.5);
                    Position = dim2(1, -14, 0.5, 0);
                    Size = dim2(0, 0, 0, 0);
                    BackgroundColor3 = rgb(20, 20, 24);
                    BorderSizePixel = 0;
                    ClipsDescendants = true;
                    Visible = false;
                    ZIndex = 50;
                })
                library:create( "UICorner" , { Parent = dock; CornerRadius = dim(0, 18) })
                library:create( "UIStroke" , { Parent = dock; Color = rgb(34, 34, 42); ApplyStrokeMode = Enum.ApplyStrokeMode.Border })
                library:create( "UIListLayout" , {
                    Parent = dock;
                    FillDirection = Enum.FillDirection.Vertical;
                    HorizontalAlignment = Enum.HorizontalAlignment.Center;
                    VerticalAlignment = Enum.VerticalAlignment.Center;
                    Padding = dim(0, 8);
                    SortOrder = Enum.SortOrder.LayoutOrder;
                })
                library:create( "UIPadding" , {
                    Parent = dock;
                    PaddingTop = dim(0, 9); PaddingBottom = dim(0, 9);
                    PaddingLeft = dim(0, 8); PaddingRight = dim(0, 8);
                })
                dock.InputBegan:Connect(begin_dock_drag)
                -- Published so library:set_dock_enabled can reach the pill from
                -- outside this closure (Safe Mode hides it).
                library.dock_frame = dock
                return dock
            end

            local function dock_icon_count()
                local n = 0
                for _, child in ipairs(dock:GetChildren()) do
                    if child:IsA("TextButton") then n = n + 1 end
                end
                return n
            end

            local function dock_full_size()
                local n = dock_icon_count()
                if n < 1 then n = 1 end
                return dim2(0, 56, 0, n * 40 + (n - 1) * 8 + 18)
            end

            local function refresh_dock_icons()
                build_dock()
                for _, child in ipairs(dock:GetChildren()) do
                    if child:IsA("TextButton") then child:Destroy() end
                end
                -- Build a case-insensitive lookup of the excluded-tab names once.
                local excluded = {}
                for key, val in pairs(library.dock_excluded_tabs or {}) do
                    if val and type(key) == "string" then
                        excluded[key:lower()] = true
                    end
                end

                local order = 0
                for _, tab in ipairs(cfg._tabs or {}) do
                    -- Mirror the sidebar exactly: skip tabs whose button was removed
                    -- (e.g. the hidden safesink tab) or whose name is null-prefixed.
                    local btnValid = tab.button and tab.button.Parent ~= nil
                    local hidden = type(tab.name) == "string" and tab.name:sub(1, 1) == "\0"
                    -- Also skip any tab explicitly excluded from the dock.
                    local isExcluded = type(tab.name) == "string" and excluded[tab.name:lower()] == true
                    if btnValid and not hidden and not isExcluded then
                        order = order + 1
                        local dbtn = library:create( "TextButton" , {
                            Parent = dock;
                            Name = "\0";
                            Size = dim2(0, 40, 0, 40);
                            BackgroundColor3 = rgb(27, 27, 32);
                            BorderSizePixel = 0;
                            AutoButtonColor = false;
                            Text = "";
                            LayoutOrder = order;
                            ZIndex = 51;
                        })
                        library:create( "UICorner" , { Parent = dbtn; CornerRadius = dim(0, 12) })
                        library:create( "UIStroke" , { Parent = dbtn; Color = rgb(34, 34, 42); ApplyStrokeMode = Enum.ApplyStrokeMode.Border })
                        library:create( "ImageLabel" , {
                            Parent = dbtn;
                            Name = "\0";
                            AnchorPoint = vec2(0.5, 0.5);
                            Position = dim2(0.5, 0, 0.5, 0);
                            Size = dim2(0, 20, 0, 20);
                            BackgroundTransparency = 1;
                            Image = (tab.icon and tab.icon.Image) or "http://www.roblox.com/asset/?id=6034767608";
                            ImageColor3 = (tab.icon and tab.icon.ImageColor3) or themes.preset.accent;
                            ZIndex = 52;
                        })
                        local dscale = library:create( "UIScale" , { Parent = dbtn; Scale = 1 })
                        dbtn.MouseEnter:Connect(function()
                            library:tween(dbtn, { BackgroundColor3 = rgb(38, 38, 46) }, Enum.EasingStyle.Quad, 0.16)
                            library:tween(dscale, { Scale = 1.12 }, Enum.EasingStyle.Back, 0.2)
                        end)
                        dbtn.MouseLeave:Connect(function()
                            library:tween(dbtn, { BackgroundColor3 = rgb(27, 27, 32) }, Enum.EasingStyle.Quad, 0.16)
                            library:tween(dscale, { Scale = 1 }, Enum.EasingStyle.Back, 0.2)
                        end)
                        -- Icons are drag handles too, so the pill can be grabbed
                        -- anywhere; the threshold keeps a tap working as a shortcut.
                        dbtn.InputBegan:Connect(begin_dock_drag)
                        dbtn.MouseButton1Click:Connect(function()
                            if dock_suppress_click then return end
                            cfg.toggle_menu(true)
                            if tab.select then pcall(tab.select) end
                        end)
                    end
                end
            end

            -- Every menu animation is tracked so the next toggle can cancel it. Without
            -- this, spamming the bind stacks a fresh set of tweens on the same
            -- properties each press: they all keep playing, fight each other, and the
            -- orphaned task.delay bodies from earlier presses still fire. That is what
            -- made the animation degrade and drag FPS down the longer you spammed it.
            cfg._menu_tweens = cfg._menu_tweens or {}
            cfg._menu_token = cfg._menu_token or 0

            local function cancel_menu_tweens()
                local bag = cfg._menu_tweens
                for i = #bag, 1, -1 do
                    pcall(function() bag[i]:Cancel() end)
                    bag[i] = nil
                end
            end

            -- library:tween already cancels a competing tween on the same property;
            -- this additionally records the handle so a toggle can cancel animations
            -- the next toggle would not otherwise touch (a half-played dock resize).
            local function menu_tween(obj, props, style, time)
                local tween = library:tween(obj, props, style, time)
                if tween then
                    cfg._menu_tweens[#cfg._menu_tweens + 1] = tween
                end
                return tween
            end

            function cfg.toggle_menu(bool)
                bool = bool and true or false
                if bool == cfg.menu_open then return end
                cfg.menu_open = bool
                library.menu_visible = bool
                library[ "items" ].Enabled = true
                local mainScale = items[ "main_scale" ]

                -- Kill whatever the previous press was still animating, and bump the
                -- token so its pending task.delay bodies become no-ops.
                cancel_menu_tweens()
                cfg._menu_token = cfg._menu_token + 1
                local token = cfg._menu_token

                -- Where the window shrinks into / grows out of. Because UIScale
                -- pivots at the window's top-left, parking the top-left just left of
                -- the dock makes the collapsed window land right on top of the pill,
                -- so it reads as the window folding straight into the dock.
                local parked = dim2(1, -68, 0.5, -18)
                -- Once the dock has been moved, collapse toward wherever it now is
                -- instead of the fixed right-edge spot, so the hand-off still reads
                -- as the window folding into the pill.
                if dock and dock_pos_normalised then
                    parked = dim_offset(dock.Position.X.Offset - 54, dock.Position.Y.Offset - 18)
                end

                -- Timings tuned so the two halves hand off cleanly instead of
                -- animating over each other: window collapses, THEN the pill pops.
                local WIN_T  = 0.24   -- window shrink / grow
                local HANDOFF = 0.12  -- pill starts this far into the window anim
                local DOCK_T = 0.30   -- pill grow / shrink

                -- The window itself is NEVER animated. Tweening its Position (and
                -- especially a UIScale on it) forces the engine to re-layout and
                -- re-render every one of its ~2000 descendants on every frame of the
                -- animation, which is what made minimise/open look choppy no matter
                -- how good the framerate was. Instead we animate the same lightweight
                -- ghost the drag code uses -- one Frame + corner + stroke -- and just
                -- flip the real window's Visible at the ends. Cost is constant
                -- regardless of how many elements the menu has.
                local ghost = cfg._menu_ghost
                if not ghost or not ghost.Parent then
                    ghost = library:ghost_for(items[ "main" ])
                    cfg._menu_ghost = ghost
                end

                -- Solid, and the same colour as the window itself. ghost_for defaults
                -- to a translucent placeholder because that reads well over a window
                -- you are dragging, but here the window is hidden, so a see-through
                -- box just looks like a floating outline. Opaque makes the morph read
                -- as the window shrinking rather than a ghost of it.
                ghost.BackgroundColor3 = items[ "main" ].BackgroundColor3
                ghost.BackgroundTransparency = 0

                local pill_size = dim2(0, 40, 0, 40)
                -- Parked far off-screen instead of Visible = false. Flipping Visible
                -- on a tree this size makes the engine re-draw the whole thing on the
                -- frame it comes back, which is a guaranteed hitch exactly when the
                -- open animation starts. Off-screen it stays drawn and costs nothing
                -- to bring back -- it is a Position write, no layout, no first paint.
                local OFFSCREEN = dim2(0, -6000, 0, -6000)

                if mainScale and mainScale.Scale ~= 1 then mainScale.Scale = 1 end
                if not items[ "main" ].Visible then items[ "main" ].Visible = true end

                if bool then
                    -- OPEN: grow the ghost out of the pill so the window visibly comes
                    -- FROM the dock, then hand off to the real window the moment it
                    -- reaches full size. The real window is already drawn (parked
                    -- off-screen), so the hand-off is a single Position write.
                    local restore = cfg._restore_pos or items[ "main" ].Position
                    local full_size = cfg._menu_full_size or items[ "main" ].Size

                    if dock and dock.Visible then
                        menu_tween(dock, { Size = dim2(0, 0, 0, 0) }, Enum.EasingStyle.Quart, 0.14)
                    end

                    ghost.Position = parked
                    ghost.Size = pill_size
                    ghost.Visible = true

                    -- Quart, and a touch quicker than the collapse: the ghost is a
                    -- plain box, so the less time it is the only thing on screen the
                    -- better it reads.
                    menu_tween(ghost, { Position = restore, Size = full_size }, Enum.EasingStyle.Quart, WIN_T)

                    task.delay(WIN_T, function()
                        if token ~= cfg._menu_token then return end
                        if not cfg.menu_open then return end

                        items[ "main" ].Position = restore
                        items[ "main" ].BackgroundTransparency = 0
                        ghost.Visible = false
                        if dock then dock.Visible = false end
                    end)
                else
                    -- CLOSE: hand the window's footprint to the ghost, hide the real
                    -- window immediately, then shrink the ghost into the dock spot.
                    cfg._restore_pos = items[ "main" ].Position
                    cfg._menu_full_size = items[ "main" ].Size

                    ghost.Position = items[ "main" ].Position
                    ghost.Size = items[ "main" ].Size
                    ghost.Visible = true
                    -- Park off-screen rather than hiding, so re-opening costs a single
                    -- Position write instead of a full re-draw of the whole tree.
                    items[ "main" ].Position = OFFSCREEN

                    -- Quad ease-in: it accelerates as it collapses, so it looks like
                    -- it is being pulled into the dock rather than gliding. It stays
                    -- fully opaque the whole way -- fading it out mid-flight made it
                    -- read as a translucent box floating over the dock instead of the
                    -- window folding away.
                    menu_tween(ghost, { Position = parked, Size = pill_size }, Enum.EasingStyle.Quad, WIN_T)

                    -- Build the pill hidden. The dock is NOT popped partway through
                    -- any more: the ghost is still shrinking then, so the two
                    -- overlapped and you could see the box sitting on top of the
                    -- arriving pill. The ghost now disappears and the pill pops in the
                    -- same frame, so it reads as a clean hand-off.
                    refresh_dock_icons()
                    dock.Visible = false

                    task.delay(WIN_T, function()
                        if token ~= cfg._menu_token then return end
                        if cfg.menu_open then return end

                        ghost.Visible = false
                        items[ "main" ].BackgroundTransparency = 0
                        -- Stays off-screen while closed; OPEN moves it back.

                        -- Safe Mode (library.dock_enabled == false) suppresses the
                        -- pill entirely: the window still collapses, it just leaves
                        -- nothing on screen behind it.
                        if dock and library.dock_enabled ~= false then
                            dock.Visible = true
                            dock.Size = dim2(0, 20, 0, 40)
                            menu_tween(dock, { Size = dock_full_size() }, Enum.EasingStyle.Back, DOCK_T)
                        end
                    end)
                end
            end

            -- ── Mobile open/close button ────────────────────────────────────────
            -- Touch-only devices have no keybind to bring the menu back, so the
            -- library ships its own draggable floating button. It lives here rather
            -- than in each script so every consumer of the library gets it. A small
            -- movement threshold separates a drag from a tap.
            if uis.TouchEnabled and not uis.MouseEnabled and not uis.KeyboardEnabled then
                local mobile_btn = library:create( "ImageButton" , {
                    Parent = library[ "items" ];
                    Name = "\0";
                    AnchorPoint = vec2(0.5, 0);
                    Position = dim2(0.5, 0, 0, 6);
                    Size = dim2(0, 44, 0, 44);
                    BackgroundColor3 = rgb(18, 18, 22);
                    BackgroundTransparency = 0.15;
                    BorderSizePixel = 0;
                    AutoButtonColor = true;
                    ScaleType = Enum.ScaleType.Fit;
                    Image = cfg.icon or library.window_icon or "rbxassetid://10709790948";
                    ZIndex = 60;
                })
                library:create( "UICorner" , { Parent = mobile_btn; CornerRadius = dim(0, 10) })
                library:create( "UIStroke" , { Parent = mobile_btn; Color = rgb(60, 60, 68); ApplyStrokeMode = Enum.ApplyStrokeMode.Border })
                library.mobile_button = mobile_btn

                local TAP_THRESHOLD = 8
                local press_start, start_anchor, press_moved

                mobile_btn.InputBegan:Connect(function(input)
                    if input.UserInputType ~= Enum.UserInputType.Touch
                        and input.UserInputType ~= Enum.UserInputType.MouseButton1 then
                        return
                    end
                    press_start = input.Position
                    start_anchor = mobile_btn.AbsolutePosition
                        + vec2(
                            mobile_btn.AbsoluteSize.X * mobile_btn.AnchorPoint.X,
                            mobile_btn.AbsoluteSize.Y * mobile_btn.AnchorPoint.Y
                        )
                    press_moved = false
                end)

                uis.InputChanged:Connect(function(input)
                    if not press_start then return end
                    if input.UserInputType ~= Enum.UserInputType.Touch
                        and input.UserInputType ~= Enum.UserInputType.MouseMovement then
                        return
                    end
                    local dx = input.Position.X - press_start.X
                    local dy = input.Position.Y - press_start.Y
                    if not press_moved and (abs(dx) > TAP_THRESHOLD or abs(dy) > TAP_THRESHOLD) then
                        press_moved = true
                    end
                    if press_moved then
                        mobile_btn.Position = dim_offset(start_anchor.X + dx, start_anchor.Y + dy)
                    end
                end)

                local function end_mobile_press(input)
                    if input.UserInputType ~= Enum.UserInputType.Touch
                        and input.UserInputType ~= Enum.UserInputType.MouseButton1 then
                        return
                    end
                    if not press_start then return end
                    press_start = nil
                    if not press_moved then
                        cfg.toggle_menu(not cfg.menu_open)
                    end
                    press_moved = false
                end

                mobile_btn.InputEnded:Connect(end_mobile_press)
                uis.InputEnded:Connect(end_mobile_press)
            end

            library:begin_build()
            task.delay(60, function() library:end_build() end)

            return setmetatable(cfg, library)
        end

        function library:tab(properties)
            local cfg = {
                name = properties.name or properties.Name or "visuals";
                icon = properties.icon or properties.Icon or "http://www.roblox.com/asset/?id=6034767608";

                tabs = properties.tabs or properties.Tabs or {"Main", "Misc.", "Settings"};
                pages = {};
                current_multi;

                items = {};
            }

            local items = cfg.items; do
                items[ "tab_holder" ] = library:create( "Frame" , {
                    Parent = library.cache;
                    Name = "\0";
                    Visible = false;
                    BackgroundTransparency = 1;
                    Position = dim2(0, 196, 0, 56);
                    BorderColor3 = rgb(0, 0, 0);
                    Size = dim2(1, -216, 1, -101);
                    BorderSizePixel = 0;
                    BackgroundColor3 = rgb(255, 255, 255)
                });

                    items[ "button" ] = library:create( "TextButton" , {
                        FontFace = fonts.font;
                        TextColor3 = rgb(255, 255, 255);
                        BorderColor3 = rgb(0, 0, 0);
                        Text = "";
                        Parent = self.items[ "button_holder" ];
                        AutoButtonColor = false;
                        BackgroundTransparency = 1;
                        Name = "\0";
                        Size = dim2(1, 0, 0, 35);
                        BorderSizePixel = 0;
                        TextSize = 16;
                        BackgroundColor3 = rgb(29, 29, 29)
                    });

                    items[ "icon" ] = library:create( "ImageLabel" , {
                        ImageColor3 = themes.preset.accent;
                        BorderColor3 = rgb(0, 0, 0);
                        Parent = items[ "button" ];
                        AnchorPoint = vec2(0, 0.5);
                        Image = "http://www.roblox.com/asset/?id=6034767608";
                        BackgroundTransparency = 1;
                        Position = dim2(0, 10, 0.5, 0);
                        Name = "\0";
                        Size = dim2(0, 22, 0, 22);
                        BorderSizePixel = 0;
                        BackgroundColor3 = rgb(255, 255, 255)
                    }); library:apply_theme(items[ "icon" ], "accent", "ImageColor3");

                    items[ "name" ] = library:create( "TextLabel" , {
                        FontFace = fonts.font;
                        TextColor3 = rgb(72, 72, 73);
                        BorderColor3 = rgb(0, 0, 0);
                        Text = cfg.name;
                        Parent = items[ "button" ];
                        Name = "\0";
                        Size = dim2(0, 0, 1, 0);
                        Position = dim2(0, 40, 0, 0);
                        BackgroundTransparency = 1;
                        TextXAlignment = Enum.TextXAlignment.Left;
                        BorderSizePixel = 0;
                        AutomaticSize = Enum.AutomaticSize.X;
                        TextSize = 16;
                        BackgroundColor3 = rgb(255, 255, 255)
                    });

                    library:create( "UIPadding" , {
                        Parent = items[ "name" ];
                        PaddingRight = dim(0, 5);
                        PaddingLeft = dim(0, 5)
                    });

                    library:create( "UICorner" , {
                        Parent = items[ "button" ];
                        CornerRadius = dim(0, 7)
                    });

                    library:create( "UIStroke" , {
                        Color = rgb(23, 23, 29);
                        Parent = items[ "button" ];
                        Enabled = false;
                        ApplyStrokeMode = Enum.ApplyStrokeMode.Border
                    });

                    items[ "multi_section_button_holder" ] = library:create( "Frame" , {
                        Parent = library.cache;
                        BackgroundTransparency = 1;
                        Name = "\0";
                        Visible = false;
                        BorderColor3 = rgb(0, 0, 0);
                        Size = dim2(1, 0, 1, 0);
                        BorderSizePixel = 0;
                        BackgroundColor3 = rgb(255, 255, 255)
                    });

                    library:create( "UIListLayout" , {
                        Parent = items[ "multi_section_button_holder" ];
                        Padding = dim(0, 7);
                        SortOrder = Enum.SortOrder.LayoutOrder;
                        FillDirection = Enum.FillDirection.Horizontal
                    });

                    library:create( "UIPadding" , {
                        PaddingTop = dim(0, 8);
                        PaddingBottom = dim(0, 7);
                        Parent = items[ "multi_section_button_holder" ];
                        PaddingRight = dim(0, 7);
                        PaddingLeft = dim(0, 7)
                    });

                    for _, section in cfg.tabs do
                        local data = {items = {}}

                        local multi_items = data.items; do

                                multi_items[ "button" ] = library:create( "TextButton" , {
                                    FontFace = fonts.font;
                                    TextColor3 = rgb(255, 255, 255);
                                    BorderColor3 = rgb(0, 0, 0);
                                    AutoButtonColor = false;
                                    Text = "";
                                    Parent = items[ "multi_section_button_holder" ];
                                    Name = "\0";
                                    Size = dim2(0, 0, 0, 39);
                                    BackgroundTransparency = 1;
                                    ClipsDescendants = true;
                                    BorderSizePixel = 0;
                                    AutomaticSize = Enum.AutomaticSize.X;
                                    TextSize = 16;
                                    BackgroundColor3 = rgb(25, 25, 29)
                                });

                                multi_items[ "icon" ] = library:create( "ImageLabel" , {
                                    ImageColor3 = themes.preset.accent;
                                    BorderColor3 = rgb(0, 0, 0);
                                    Parent = multi_items[ "button" ];
                                    AnchorPoint = vec2(0, 0.5);
                                    Image = items[ "icon" ].Image;
                                    BackgroundTransparency = 1;
                                    Position = dim2(0, 0, 0.5, 0);
                                    Name = "\0";
                                    Size = dim2(0, 18, 0, 18);
                                    BorderSizePixel = 0;
                                    BackgroundColor3 = rgb(255, 255, 255)
                                }); library:apply_theme(multi_items[ "icon" ], "accent", "ImageColor3");

                                local function sync_icon()
                                    multi_items[ "icon" ].Image = items[ "icon" ].Image
                                end
                                sync_icon()
                                library:connection(items[ "icon" ]:GetPropertyChangedSignal("Image"), sync_icon)

                                multi_items[ "name" ] = library:create( "TextLabel" , {
                                    FontFace = fonts.font;
                                    TextColor3 = rgb(62, 62, 63);
                                    BorderColor3 = rgb(0, 0, 0);
                                    Text = section;
                                    Parent = multi_items[ "button" ];
                                    Name = "\0";
                                    Position = dim2(0, 24, 0, 0);
                                    Size = dim2(0, 0, 1, 0);
                                    BackgroundTransparency = 1;
                                    TextXAlignment = Enum.TextXAlignment.Left;
                                    BorderSizePixel = 0;
                                    AutomaticSize = Enum.AutomaticSize.XY;
                                    TextSize = 16;
                                    BackgroundColor3 = rgb(255, 255, 255)
                                });

                                library:create( "UIPadding" , {
                                    Parent = multi_items[ "name" ];
                                    PaddingRight = dim(0, 5);
                                    PaddingLeft = dim(0, 5)
                                });

                                multi_items[ "accent" ] = library:create( "Frame" , {
                                    BorderColor3 = rgb(0, 0, 0);
                                    AnchorPoint = vec2(0, 1);
                                    Parent = multi_items[ "button" ];
                                    BackgroundTransparency = 1;
                                    Position = dim2(0, 10, 1, 4);
                                    Name = "\0";
                                    Size = dim2(1, -20, 0, 6);
                                    BorderSizePixel = 0;
                                    BackgroundColor3 = themes.preset.accent
                                }); library:apply_theme(multi_items[ "accent" ], "accent", "BackgroundColor3");

                                library:create( "UICorner" , {
                                    Parent = multi_items[ "accent" ];
                                    CornerRadius = dim(0, 999)
                                });

                                library:create( "UIPadding" , {
                                    Parent = multi_items[ "button" ];
                                    PaddingRight = dim(0, 10);
                                    PaddingLeft = dim(0, 10)
                                });

                                library:create( "UICorner" , {
                                    Parent = multi_items[ "button" ];
                                    CornerRadius = dim(0, 7)
                                });

                                multi_items[ "tab" ] = library:create( "Frame" , {
                                    Parent = library.cache;
                                    BackgroundTransparency = 1;
                                    Name = "\0";
                                    BorderColor3 = rgb(0, 0, 0);
                                    Size = dim2(1, -20, 1, -20);
                                    BorderSizePixel = 0;
                                    Visible = false;
                                    BackgroundColor3 = rgb(255, 255, 255)
                                });

                                library:create( "UIListLayout" , {
                                    FillDirection = Enum.FillDirection.Vertical;
                                    HorizontalFlex = Enum.UIFlexAlignment.Fill;
                                    Parent = multi_items[ "tab" ];
                                    Padding = dim(0, 7);
                                    SortOrder = Enum.SortOrder.LayoutOrder;
                                    VerticalFlex = Enum.UIFlexAlignment.Fill
                                });

                                library:create( "UIPadding" , {
                                    PaddingTop = dim(0, 7);
                                    PaddingBottom = dim(0, 7);
                                    Parent = multi_items[ "tab" ];
                                    PaddingRight = dim(0, 7);
                                    PaddingLeft = dim(0, 7)
                                });

                        end

                        data.text = multi_items[ "name" ]
                        data.accent = multi_items[ "accent" ]
                        data.button = multi_items[ "button" ]
                        data.page = multi_items[ "tab" ]
                        data.parent = setmetatable(data, library):sub_tab({}).items[ "tab_parent" ]

						function data.open_page()
							local page = cfg.current_multi;

                            if page and page.text ~= data.text then
                                self.items[ "global_fade" ].BackgroundTransparency = 0
                                library:tween(self.items[ "global_fade" ], {BackgroundTransparency = 1}, Enum.EasingStyle.Quad, 0.4)

                                local old_size = page.page.Size
                                page.page.Size = dim2(1, -20, 1, -20)
                            end

                            if page then
                                library:tween(page.text, {TextColor3 = rgb(62, 62, 63)})
                                library:tween(page.accent, {BackgroundTransparency = 1})
                                library:tween(page.button, {BackgroundTransparency = 1})

                                page.page.Visible = false
                                page.page.Parent = library[ "cache" ]
                            end

                            library:tween(data.text, {TextColor3 = rgb(255, 255, 255)})
                            library:tween(data.accent, {BackgroundTransparency = 0})
                            library:tween(data.button, {BackgroundTransparency = 0})
                            library:tween(data.page, {Size = dim2(1, 0, 1, 0)}, Enum.EasingStyle.Quad, 0.4)

                            data.page.Visible = true
                            data.page.Parent = items["tab_holder"]

                            cfg.current_multi = data

                            library:close_element()
						end

						multi_items[ "button" ].MouseButton1Down:Connect(function()
							data.open_page()
						end)

						cfg.pages[#cfg.pages + 1] = setmetatable(data, library)
                    end

                    cfg.pages[1].open_page()

            end

            function cfg.open_tab()
                local selected_tab = self.selected_tab

                if selected_tab then
                    if selected_tab[ 4 ] ~= items[ "tab_holder" ] then
                        self.items[ "global_fade" ].BackgroundTransparency = 0

                        library:tween(self.items[ "global_fade" ], {BackgroundTransparency = 1}, Enum.EasingStyle.Quad, 0.4)
                        selected_tab[ 4 ].Size = dim2(1, -216, 1, -101)
                    end

                    library:tween(selected_tab[ 1 ], {BackgroundTransparency = 1})
                    library:tween(selected_tab[ 2 ], {ImageColor3 = themes.preset.accent})
                    library:tween(selected_tab[ 3 ], {TextColor3 = rgb(72, 72, 73)})

                    selected_tab[ 4 ].Visible = false
                    selected_tab[ 4 ].Parent = library[ "cache" ]
                    selected_tab[ 5 ].Visible = false
                    selected_tab[ 5 ].Parent = library[ "cache" ]
                end

                library:tween(items[ "button" ], {BackgroundTransparency = 0})
                library:tween(items[ "icon" ], {ImageColor3 = themes.preset.accent})
                library:tween(items[ "name" ], {TextColor3 = rgb(255, 255, 255)})
                library:tween(items[ "tab_holder" ], {Size = dim2(1, -196, 1, -81)}, Enum.EasingStyle.Quad, 0.4)

                items[ "tab_holder" ].Visible = true
                items[ "tab_holder" ].Parent = self.items[ "main" ]
                items[ "multi_section_button_holder" ].Visible = true
                items[ "multi_section_button_holder" ].Parent = self.items[ "multi_holder" ]

                self.selected_tab = {
                    items[ "button" ];
                    items[ "icon" ];
                    items[ "name" ];
                    items[ "tab_holder" ];
                    items[ "multi_section_button_holder" ];
                }

                library:close_element()
            end

            items[ "button" ].MouseButton1Down:Connect(function()
                cfg.open_tab()
            end)

            do
                -- Register this tab so the minimise dock (velhubui-style tab-icon pill)
                -- can list its icon and reselect it. Live references are stored so any
                -- later icon/theme change is reflected when the dock is (re)built.
                self._tabs = self._tabs or {}
                self._tabs[#self._tabs + 1] = {
                    name = cfg.name,
                    button = items[ "button" ],
                    icon = items[ "icon" ],
                    select = function() cfg.open_tab() end,
                }
            end

            if not self.selected_tab then
                cfg.open_tab(true)
            end

            return unpack(cfg.pages)
        end

        function library:seperator(properties)
            local cfg = {items = {}, name = properties.Name or properties.name or "General"}

            local items = cfg.items do
                items[ "name" ] = library:create( "TextLabel" , {
                    FontFace = fonts.font;
                    TextColor3 = rgb(72, 72, 73);
                    BorderColor3 = rgb(0, 0, 0);
                    Text = cfg.name;
                    Parent = self.items[ "button_holder" ];
                    Name = "\0";
                    Size = dim2(1, 0, 0, 0);
                    Position = dim2(0, 40, 0, 0);
                    BackgroundTransparency = 1;
                    TextXAlignment = Enum.TextXAlignment.Left;
                    BorderSizePixel = 0;
                    AutomaticSize = Enum.AutomaticSize.XY;
                    TextSize = 16;
                    BackgroundColor3 = rgb(255, 255, 255)
                });

                library:create( "UIPadding" , {
                    Parent = items[ "name" ];
                    PaddingRight = dim(0, 5);
                    PaddingLeft = dim(0, 5)
                });
            end;

            return setmetatable(cfg, library)
        end

            function library:column(properties)
                local cfg = {items = {}, size = properties.size or 1}

                local items = cfg.items; do
                    items[ "column" ] = library:create( "Frame" , {
                        Parent = self[ "parent" ] or self.items["tab_parent"];
                        BackgroundTransparency = 1;
                        Name = "\0";
                        BorderColor3 = rgb(0, 0, 0);
                        Size = dim2(0, 0, cfg.size, 0);
                        BorderSizePixel = 0;
                        BackgroundColor3 = rgb(255, 255, 255)
                    });

                    library:create( "UIPadding" , {
                        PaddingBottom = dim(0, 10);
