                    });

                    items[ "scale" ] = library:create( "UIScale" , {
                        Parent = items[ "outline" ];
                        Scale = 1
                    });

            end

            function cfg.render_option(text)
                local button = library:create( "TextButton" , {
                    FontFace = fonts.small;
                    TextColor3 = rgb(72, 72, 73);
                    BorderColor3 = rgb(0, 0, 0);
                    Text = text;
                    Parent = items[ "list" ];
                    Name = "\0";
                    Size = dim2(1, -6, 0, 24);
                    BackgroundTransparency = 1;
                    TextXAlignment = Enum.TextXAlignment.Left;
                    TextTruncate = Enum.TextTruncate.AtEnd;
                    BorderSizePixel = 0;
                    AutomaticSize = Enum.AutomaticSize.Y;
                    TextSize = 14;
                    BackgroundColor3 = themes.preset.accent;
                    ZIndex = 10;
                }); library:apply_theme(button, "accent", "TextColor3"); library:apply_theme(button, "accent", "BackgroundColor3")

                library:create( "UICorner" , {
                    Parent = button;
                    CornerRadius = dim(0, 5)
                });

                library:create( "UIPadding" , {
                    Parent = button;
                    PaddingTop = dim(0, 4);
                    PaddingBottom = dim(0, 4);
                    PaddingRight = dim(0, 8);
                    PaddingLeft = dim(0, 8)
                });

                local function isSelected()
                    if cfg.multi then return find(cfg.multi_items, button.Text) ~= nil end
                    return flags[cfg.flag] == button.Text
                end

                button.MouseEnter:Connect(function()
                    library:tween(button, { BackgroundTransparency = 0 }, Enum.EasingStyle.Quad, 0.12)
                    library:tween(button, { TextColor3 = rgb(18, 18, 22) }, Enum.EasingStyle.Quad, 0.12)
                end)
                button.MouseLeave:Connect(function()
                    library:tween(button, { BackgroundTransparency = 1 }, Enum.EasingStyle.Quad, 0.12)
                    library:tween(button, { TextColor3 = isSelected() and themes.preset.accent or rgb(72, 72, 73) }, Enum.EasingStyle.Quad, 0.12)
                end)

                return button
            end

            local function applySearchFilter()
                local box = items[ "search_box" ]
                if not box then return end
                local query = box.Text:lower()
                local alias = cfg.search_alias
                for _, option in cfg.option_instances do
                    local match = (query == "") or (option.Text:lower():find(query, 1, true) ~= nil)

                    if not match and alias then
                        local extra = alias[option.Text]
                        if extra and extra:lower():find(query, 1, true) ~= nil then
                            match = true
                        end
                    end
                    option.Visible = match
                end
            end
            cfg.apply_search_filter = applySearchFilter

            if items[ "search_box" ] then
                items[ "search_box" ]:GetPropertyChangedSignal("Text"):Connect(applySearchFilter)
            end

            function cfg.set_visible(bool)
                -- The cap applies to every dropdown, not just ones declared with
                -- scrolling = true. Without it a long option set (every character in
                -- the game) opened a list taller than the window and covered the page;
                -- past the cap the list just scrolls.
                local target = cfg.y_size
                local cap = cfg.max_height or 240
                if target > cap then
                    target = cap
                end
                target += SEARCH_BOX_HEIGHT
                local a = bool and target or 0

                local last_px, last_py
                local function reposition()
                    -- The list is exactly as wide as the box and left-aligned with it,
                    -- so it reads as the box unrolling rather than a separate popup
                    -- that happens to appear nearby. The vertical offset is the old
                    -- constant re-expressed relative to the box height, so it still
                    -- lands in the same place for the default 16px box but stays
                    -- attached if the box is ever made taller.
                    local box = items[ "dropdown" ]
                    local popWidth = box.AbsoluteSize.X
                    local px = box.AbsolutePosition.X
                    local py = box.AbsolutePosition.Y + box.AbsoluteSize.Y + 64

                    if px ~= last_px or py ~= last_py then
                        last_px, last_py = px, py
                        items[ "dropdown_holder" ].Position = dim2(0, px, 0, py)
                    end
                    return popWidth
                end

                if cfg._follow then cfg._follow:Disconnect(); cfg._follow = nil end

                local popWidth = reposition()
                -- Quint out on the way open and a slightly quicker one closing: the
                -- height tween is what reads as the roll-down, so it carries the
                -- animation and the scale/fade below only soften its start.
                library:tween(items[ "dropdown_holder" ], { Size = dim_offset(popWidth, a) },
                    Enum.EasingStyle.Quint, bool and 0.28 or 0.18)

                -- Arrows pick up the accent while the list is down, so an open
                -- dropdown is obvious even when the list is off to the side.
                if items[ "indicator" ] then
                    library:tween(items[ "indicator" ],
                        { ImageColor3 = bool and themes.preset.accent or rgb(86, 86, 87) },
                        Enum.EasingStyle.Quad, 0.18)
                end

                if bool then
                    cfg._follow = run.RenderStepped:Connect(reposition)
                    if items[ "scale" ] then
                        -- 0.96 rather than 0.9: at full box width a heavy scale-up
                        -- makes the edges visibly slide inward, which fought the
                        -- roll-down. This just takes the hard edge off the first frame.
                        items[ "scale" ].Scale = 0.96
                        library:tween(items[ "scale" ], { Scale = 1 }, Enum.EasingStyle.Quart, 0.26)
                    end
                    -- Fade the panel in over the first third of the roll-down so the
                    -- list does not pop into existence at full opacity on frame one.
                    items[ "outline" ].BackgroundTransparency = 1
                    library:tween(items[ "outline" ], { BackgroundTransparency = 0 }, Enum.EasingStyle.Quad, 0.12)
                elseif items[ "search_box" ] then
                    -- Reset the filter on close so the next open shows every option.
                    items[ "search_box" ]:ReleaseFocus()
                    items[ "search_box" ].Text = ""
                end

                if not (self.sanity and library.current_open == self) then
                    library:close_element(cfg)
                end
            end

            function cfg.set(value)
                local selected = {}
                local isTable = type(value) == "table"

                for _, option in cfg.option_instances do
                    if option.Text == value or (isTable and find(value, option.Text)) then
                        insert(selected, option.Text)
                        cfg.multi_items = selected
                        option.TextColor3 = themes.preset.accent
                    else
                        option.TextColor3 = rgb(72, 72, 73)
                    end
                end

                items[ "sub_text" ].Text = isTable and concat(selected, ", ") or selected[1] or ""
                flags[cfg.flag] = isTable and selected or selected[1]

                cfg.callback(flags[cfg.flag])
            end

            function cfg.refresh_options(list)
                cfg.y_size = 0

                for _, option in cfg.option_instances do
                    option:Destroy()
                end

                cfg.option_instances = {}

                for _, option in list do
                    local button = cfg.render_option(option)
                    cfg.y_size += button.AbsoluteSize.Y + 6
                    insert(cfg.option_instances, button)

                    button.MouseButton1Down:Connect(function()
                        if cfg.multi then
                            local selected_index = find(cfg.multi_items, button.Text)

                            if selected_index then
                                remove(cfg.multi_items, selected_index)
                            else
                                insert(cfg.multi_items, button.Text)
                            end

                            cfg.set(cfg.multi_items)
                        else
                            cfg.set_visible(false)
                            cfg.open = false

                            cfg.set(button.Text)
                        end
                    end)
                end

                applySearchFilter()
            end

            items[ "dropdown" ].MouseButton1Click:Connect(function()
                cfg.open = not cfg.open

                cfg.set_visible(cfg.open)
            end)

            if cfg.seperator then
                library:create( "Frame" , {
                    AnchorPoint = vec2(0, 1);
                    Parent = self.items[ "elements" ];
                    Position = dim2(0, 0, 1, 0);
                    BorderColor3 = rgb(0, 0, 0);
                    Size = dim2(1, 1, 0, 1);
                    BorderSizePixel = 0;
                    BackgroundColor3 = rgb(36, 36, 37)
                });
            end

            flags[cfg.flag] = {}
            config_flags[cfg.flag] = cfg.set

            cfg.refresh_options(cfg.options)
            cfg.set(cfg.default)

            return setmetatable(cfg, library)
        end

